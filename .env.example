# Sécurité & Sessions
NUXT_SESSION_PASSWORD=00000000000000000000000000000000
SECRET_KEY=00000000000000000000000000000000
ENCRYPTION_KEY=00000000000000000000000000000000

GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# --- Rate-limiting & Proxy ---
# N'activer QUE derrière un reverse proxy de confiance (nginx/Traefik)
# qui strip le X-Forwarded-For entrant. Sinon laisser à false.
TRUST_PROXY_HEADERS=false
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_MINUTES=15

GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx

# --- Configuration de la Base de Données ---
DB_USER=airgap
DB_PASSWORD=airgap123
DB_NAME=airgap_db

# Cette URL sera utilisée par ton terminal local (ex: npx drizzle-kit push)
NUXT_DATABASE_URL="postgresql://airgap:airgap123@postgres:5432/airgap_db"